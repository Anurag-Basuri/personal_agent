# ==========================================
# PERSONAL AGENT - OPEN SOURCE CONFIGURATION
# ==========================================

# ─── NextAuth Settings ────────────────────
# Must match the NEXTAUTH_SECRET used in the frontend
AUTH_SECRET="your_nextauth_jwt_secret_here"

# ─── Server Configuration ─────────────────
PORT=4000
DEBUG=false
CLIENT_URL="http://localhost:3000"

# ─── Customization / PII ──────────────────
# These replace the hardcoded "Anurag Basuri" logic
AGENT_NAME="Your Name"
GITHUB_USERNAME="your-github-username"
LEETCODE_USERNAME="your-leetcode-username"

# ─── Databases ────────────────────────────
# The primary database URL. If using pgvector, ensure it starts with postgresql+asyncpg
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname"
# Optional: Only needed if importing knowledge from a separate portfolio db
PORTFOLIO_DB_URL="postgresql+asyncpg://user:password@portfolio_host/dbname"

# ─── Cryptography ─────────────────────────
# Secret 256-bit AES-GCM key base64 encoded.
# E.g., generate via python: `import os, base64; print(base64.b64encode(os.urandom(32)).decode())`
OMNI_MEMORY_KEY="base64_encoded_32_byte_string_here"

# ─── AI Providers (6-Layer Fallback Cascade) ──
# Tier 1-3: GitHub Models API (uses GITHUB_TOKEN, per-model rate limits)
GITHUB_TOKEN="your_github_pat_here"
# Tier 4: Groq — blazing fast Llama inference (https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key_here"
# Tier 5: HuggingFace — OpenAI-compatible inference (https://huggingface.co/settings/tokens)
HF_TOKEN="your_huggingface_deployment_token"

# ─── Google OAuth ─────────────────────────
# Google Cloud Console → Credentials → OAuth 2.0 Client ID
AUTH_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# ─── Telegram Bot ─────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Comma-separated list of Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS="123456789"

