# PERSONAL AGENT OPEN SOURCE CONFIGURATION

# NextAuth Settings
# Must match the NEXTAUTH_SECRET used in the frontend
AUTH_SECRET="your_nextauth_jwt_secret_here"

# Server Configuration
PORT=4000
DEBUG=false
CLIENT_URL="http://localhost:3000"
PORTFOLIO_URL="https://your-portfolio-app.vercel.app"

# Customization and Profiles
AGENT_NAME="Your Name"
GITHUB_USERNAME="your_github_username"
LEETCODE_USERNAME="your_leetcode_username"

# Databases
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname"
PORTFOLIO_DB_URL="postgresql+asyncpg://user:password@portfolio_host/dbname"

# Cryptography
# Secret 256 bit AES GCM key base64 encoded
OMNI_MEMORY_KEY="base64_encoded_32_byte_string_here"

# AI Providers (6 Layer Fallback Cascade)
# Tier 1 to 3: GitHub Models API (uses GITHUB_TOKEN)
GITHUB_TOKEN="your_github_pat_here"
# Tier 4: Groq API Key
GROQ_API_KEY="your_groq_api_key_here"
# Tier 5: HuggingFace Token
HF_TOKEN="your_huggingface_deployment_token"

# Google OAuth Client ID
AUTH_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Telegram Bot Token and Allowed User IDs
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ALLOWED_USER_IDS="123456789"

