# PERSONAL AGENT OPEN SOURCE CONFIGURATION

# NextAuth Settings
# Must match the NEXTAUTH_SECRET used in the frontend
AUTH_SECRET="your_nextauth_jwt_secret_here"

# Server Configuration
PORT=4000
DEBUG=false
CLIENT_URL="http://localhost:3000"
PORTFOLIO_URL="https://your-portfolio-app.vercel.app"

# Customization and Profiles
AGENT_NAME="Your Name"
GITHUB_USERNAME="your_github_username"
LEETCODE_USERNAME="your_leetcode_username"

# Database (Neon PostgreSQL, used for both regular DB and RAG vector store)
# Use postgresql+asyncpg:// prefix and ssl=require for Neon
DATABASE_URL="postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/neondb?ssl=require"

# ==============================================================================
# AI PROVIDERS (DUAL-BRAIN ARCHITECTURE)
# ==============================================================================
# The system cascades through available providers automatically. 
# GEMINI_API_KEY supports a comma-separated list for key rotation!

# Primary Workhorses (Powers both Thinker and Reasoner cascades)
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Deep Reasoner Fallbacks (Tools & Synthesis)
COHERE_API_KEY="your_cohere_api_key_here"
MISTRAL_API_KEY="your_mistral_api_key_here"

# ==============================================================================
# EXTERNAL APIS & TOOLS
# ==============================================================================
GITHUB_TOKEN="your_github_pat_here"
QUICKCOMMERCE_API_KEY="your_quickcommerce_api_key_here"

# Google OAuth Client ID
AUTH_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ALLOWED_USER_IDS="123456789"

# WhatsApp Notifications (CallMeBot)
CALLMEBOT_PHONE="your_phone_number_with_country_code"
CALLMEBOT_API_KEY="your_callmebot_api_key_here"
