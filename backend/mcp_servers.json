{
  "servers": {
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "vercel-mcp",
        "VERCEL_API_KEY=${VERCEL_TOKEN}"
      ],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}",
        "DOTENV_QUIET": "true"
      },
      "enabled": true
    },
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@netlify/mcp"
      ],
      "env": {
        "NETLIFY_PAT": "${NETLIFY_PAT}",
        "DOTENV_QUIET": "true"
      },
      "enabled": true
    },
    "render": {
      "transport": "streamable_http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "google": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-google-multi"
      ],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_ACCOUNTS": "${GOOGLE_ACCOUNTS}",
        "MASTER_KEY": "${MASTER_KEY}",
        "GOOGLE_PROFILE": "full-writes",
        "DOTENV_QUIET": "true"
      },
      "enabled": true
    },
    "zomato": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp-server.zomato.com/mcp"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "swiggy_food": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp.swiggy.com/food"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "swiggy_instamart": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp.swiggy.com/im"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "swiggy_dineout": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp.swiggy.com/dineout"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "quickcommerce": {
      "command": "python",
      "args": [
        "custom_mcps/quickcommerce.py"
      ],
      "env": {
        "QUICKCOMMERCE_API_KEY": "${QUICKCOMMERCE_API_KEY}"
      },
      "enabled": true
    },
    "hacker_news": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-hacker-news"
      ],
      "enabled": true
    },
    "duckduckgo": {
      "command": "npx",
      "args": [
        "-y",
        "@ericthered926/duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "sequential_thinking": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": true
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@modelcontextprotocol/server-postgres",
        "${DATABASE_URL}"
      ],
      "enabled": true
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "@mseep/linear-mcp"
      ],
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      },
      "enabled": true
    },
    "todoist": {
      "command": "npx",
      "args": [
        "-y",
        "@doist/todoist-mcp"
      ],
      "env": {
        "TODOIST_API_KEY": "${TODOIST_API_TOKEN}"
      },
      "enabled": true
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
      },
      "enabled": true
    }
  }
}
