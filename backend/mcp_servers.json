{
  "servers": {
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "vercel-mcp",
        "VERCEL_API_KEY=${VERCEL_TOKEN}"
      ],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}",
        "DOTENV_QUIET": "true"
      },
      "enabled": true
    },
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@netlify/mcp"
      ],
      "env": {
        "NETLIFY_PAT": "${NETLIFY_PAT}",
        "DOTENV_QUIET": "true"
      },
      "enabled": true
    },
    "render": {
      "transport": "streamable_http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "google": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-google-multi"
      ],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_ACCOUNTS": "${GOOGLE_ACCOUNTS}",
        "DOTENV_QUIET": "true"
      },
      "enabled": true
    },
    "zomato": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp-server.zomato.com/mcp"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "swiggy_food": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp.swiggy.com/food"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "swiggy_instamart": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp.swiggy.com/im"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "swiggy_dineout": {
      "command": "npx",
      "args": [
        "-y",
        "-q",
        "mcp-remote",
        "https://mcp.swiggy.com/dineout"
      ],
      "transport": "stdio",
      "enabled": true
    },
    "quickcommerce": {
      "transport": "streamable_http",
      "url": "https://api.quickcommerceapi.com/mcp",
      "headers": {
        "X-API-Key": "${QUICKCOMMERCE_API_KEY}"
      },
      "enabled": true
    }
  }
}
